-- ============================================================================
-- Procedure: bronze.load_bronze_layer_timed()
-- Purpose  : Load Bronze Layer with Error Handling + Execution Time Tracking
-- ============================================================================

CREATE OR REPLACE PROCEDURE bronze.load_bronze_layer_timed()
LANGUAGE plpgsql
AS $$
DECLARE
    v_start_time        TIMESTAMP;
    v_end_time          TIMESTAMP;
    v_section_start     TIMESTAMP;
    v_section_end       TIMESTAMP;
    v_duration_seconds  NUMERIC;
    v_rowcount          BIGINT;
    v_error_message     TEXT;
BEGIN

    -- ==============================================================
    -- GLOBAL START TIME
    -- ==============================================================
    v_start_time := clock_timestamp();

    RAISE NOTICE '===========================================================';
    RAISE NOTICE 'Bronze Load Started at: %', v_start_time;
    RAISE NOTICE '===========================================================';


    ---------------------------------------------------------------------------
    -- CRM - CUSTOMER INFO
    ---------------------------------------------------------------------------
    BEGIN
        v_section_start := clock_timestamp();
        RAISE NOTICE 'Loading: bronze.crm_cust_info';

        TRUNCATE TABLE bronze.crm_cust_info;

        COPY bronze.crm_cust_info
        FROM 'D:/Potencial_jobs/Samir-Abdullah-Fouad/DataEngineer_UDEMY/Building_Modern_DWH/sql_scripts/datasets/source_crm/cust_info.csv'
        DELIMITER ','
        CSV HEADER;

        SELECT COUNT(*) INTO v_rowcount FROM bronze.crm_cust_info;

        v_section_end := clock_timestamp();
        v_duration_seconds := EXTRACT(EPOCH FROM (v_section_end - v_section_start));

        RAISE NOTICE 'Rows: %, Duration: % seconds',
                     v_rowcount, v_duration_seconds;

    EXCEPTION WHEN OTHERS THEN
        v_error_message := SQLERRM;
        RAISE EXCEPTION 'Error loading crm_cust_info: %', v_error_message;
    END;


    ---------------------------------------------------------------------------
    -- CRM - PRODUCT INFO
    ---------------------------------------------------------------------------
    BEGIN
        v_section_start := clock_timestamp();
        RAISE NOTICE 'Loading: bronze.crm_prd_info';

        TRUNCATE TABLE bronze.crm_prd_info;

        COPY bronze.crm_prd_info
        FROM 'D:/Potencial_jobs/Samir-Abdullah-Fouad/DataEngineer_UDEMY/Building_Modern_DWH/sql_scripts/datasets/source_crm/prd_info.csv'
        DELIMITER ','
        CSV HEADER;

        SELECT COUNT(*) INTO v_rowcount FROM bronze.crm_prd_info;

        v_section_end := clock_timestamp();
        v_duration_seconds := EXTRACT(EPOCH FROM (v_section_end - v_section_start));

        RAISE NOTICE 'Rows: %, Duration: % seconds',
                     v_rowcount, v_duration_seconds;

    EXCEPTION WHEN OTHERS THEN
        v_error_message := SQLERRM;
        RAISE EXCEPTION 'Error loading crm_prd_info: %', v_error_message;
    END;


    ---------------------------------------------------------------------------
    -- CRM - SALES DETAILS
    ---------------------------------------------------------------------------
    BEGIN
        v_section_start := clock_timestamp();
        RAISE NOTICE 'Loading: bronze.crm_sales_details';

        TRUNCATE TABLE bronze.crm_sales_details;

        COPY bronze.crm_sales_details
        FROM 'D:/Potencial_jobs/Samir-Abdullah-Fouad/DataEngineer_UDEMY/Building_Modern_DWH/sql_scripts/datasets/source_crm/sales_details.csv'
        DELIMITER ','
        CSV HEADER;

        SELECT COUNT(*) INTO v_rowcount FROM bronze.crm_sales_details;

        v_section_end := clock_timestamp();
        v_duration_seconds := EXTRACT(EPOCH FROM (v_section_end - v_section_start));

        RAISE NOTICE 'Rows: %, Duration: % seconds',
                     v_rowcount, v_duration_seconds;

    EXCEPTION WHEN OTHERS THEN
        v_error_message := SQLERRM;
        RAISE EXCEPTION 'Error loading crm_sales_details: %', v_error_message;
    END;


    ---------------------------------------------------------------------------
    -- GLOBAL END TIME
    ---------------------------------------------------------------------------
    v_end_time := clock_timestamp();
    v_duration_seconds := EXTRACT(EPOCH FROM (v_end_time - v_start_time));

    RAISE NOTICE '===========================================================';
    RAISE NOTICE 'Bronze Load Finished at: %', v_end_time;
    RAISE NOTICE 'Total Execution Time: % seconds', v_duration_seconds;
    RAISE NOTICE '===========================================================';

END;
$$;

